# Sao chép file này thành .env rồi điền key. Không commit .env.

# Cổng và địa chỉ lắng nghe. Mặc định chỉ cho truy cập từ máy bạn (127.0.0.1).
PORT=3000
HOST=127.0.0.1

# SerpAPI: lấy Google Review (Google Maps), Google Search, Google News.
# Để trống = tự động chạy chế độ DỮ LIỆU MẪU (mock).
SERPAPI_KEY=

# Claude API: phân tích cảm xúc, chủ đề, mức độ nghiêm trọng và tóm tắt review nước ngoài bằng tiếng Việt.
# Để trống = dùng bộ luật từ khóa (kém chính xác hơn với văn bản dài hoặc mỉa mai).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ép chạy mock dù đã có key (1 = bật)
USE_MOCK=0

# Giờ tự đồng bộ review chi nhánh của mình mỗi ngày (giờ máy chủ, nhiều giờ cách nhau dấu phẩy, ví dụ 08:00,17:00).
# Server tắt lúc đến giờ thì sẽ đồng bộ bù ngay khi bật lại. Để trống = dùng SYNC_INTERVAL_MIN (phút).
SYNC_TIMES=08:00
SYNC_INTERVAL_MIN=1440
# Review đối thủ cập nhật mỗi N ngày; Google Search/News mỗi N giờ (168 = 1 tuần) để vừa gói SerpAPI Free 250 lượt/tháng
COMPETITOR_SYNC_DAYS=7
SEARCH_INTERVAL_HOURS=168

# Số trang review (10 review/trang = 1 credit SerpAPI) cho mỗi chi nhánh
REVIEW_PAGES_FIRST=5
REVIEW_PAGES_INCREMENTAL=3
